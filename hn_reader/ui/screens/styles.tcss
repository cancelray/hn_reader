Tabs {
    width: 50%;
}

Tab {
    width: 1fr;
}

#filter-input {
    width: 40%;
    height: 3;
    margin: 1 0;
}

#table-widget {
    width: 50%;
    height: 80%;
    margin-right: 1
}

#horizontal-content{
    height: 60%;
}

Markdown {
    border: white;
    border-title-align: left; 
}

Markdown MarkdownParagraph {
    text-wrap: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

#status-label {
    width: 20%;
    border: white;
    padding: 1;
    margin-bottom: 1;
}

StoryModal {
    align: center middle;
}

#modal-container {
    width: 70%;
    height: 80%;
    border: white;
}

#md-text MarkdownParagraph {
    text-wrap: wrap;
    text-overflow: fold;
    overflow: auto;
    border: none;
}
